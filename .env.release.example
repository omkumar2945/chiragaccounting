# Copy this file to .env.release and replace every value before creating a release build.
# Do not commit .env.release. Firebase API keys are public identifiers, but keeping the
# release configuration local avoids accidentally publishing development settings.

# Public backend URL. The reverse proxy serves the matching API routes at /v1.
API_BASE_URL=https://chiragaccounting.com/v1

# Firebase web/app configuration from Firebase Console > Project settings > Your apps.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MEASUREMENT_ID=
FIREBASE_IOS_BUNDLE_ID=
FIREBASE_WEB_VAPID_KEY=