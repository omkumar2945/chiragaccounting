NODE_ENV=development
PORT=8080

JWT_SECRET=replace-with-secure-secret

# Firebase Admin service-account JSON. Store this as a deployment secret.
# Download the complete JSON file from Firebase Console > Project settings >
# Service accounts > Generate new private key. Never expose it in Flutter build
# variables or source control. Use exactly one of the options below.
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=C:\secure\firebase-service-account.json

# Use localhost only when SQL Server is installed/running on this machine.
# Docker service names such as chirag-mssql work only inside their Docker network.
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=chirag_accounting
MSSQL_USER=sa
MSSQL_PASSWORD=replace-with-password
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

# SMTP credentials used exclusively for email OTP delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

ACCOUNTING_PROVIDER=erp_http
ACCOUNTING_API_BASE_URL=
ACCOUNTING_API_TOKEN=

EINVOICE_PROVIDER=http
EINVOICE_API_URL=
EINVOICE_API_KEY=

EWAY_PROVIDER=http
EWAY_API_URL=
EWAY_API_KEY=

# GSTZen account email identifies the activated subscription. Keep the
# authentication token server-side; obtain it from the GSTZen integration page.
GSTZEN_ACCOUNT_EMAIL=
GSTZEN_TOKEN=
GSTZEN_BASE_URL=https://my.gstzen.in/~gstzen/a/post-einvoice-data/einvoice-json
GSTZEN_EWAY_BILL_BASE_URL=https://my.gstzen.in/~gstzen/a/ewbapi
GSTZEN_GSTIN_VALIDATOR_URL=https://my.gstzen.in/api/gstin-validator/

# Required to encrypt each client portal connection before it is stored.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_CREDENTIAL_ENCRYPTION_KEY=

PRINTER_PROVIDER=http
PRINTER_API_URL=
PRINTER_API_KEY=

AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-5-mini

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
