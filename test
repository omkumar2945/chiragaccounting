import 'package:chirag_accounting/features/services/sales_service.dart';

void main() {
  TestWidgetsFlutterBinding.ensureInitialized();

  setUp(() {
    SharedPreferences.setMockInitialValues(<String, Object>{});
  });

  test('client can edit and delete only own unposted document', () async {
    final queue = WorkbenchQueueService();
    final job = await queue.addJob(
      fileName: 'invoice.pdf',
      autoProcess: false,
      clientId: 'client-1',
      assignedAccountantId: 'accountant-1',
    );

    expect(
      queue.updateClientDocument(
        jobId: job.id,
        clientId: 'client-2',
        fileName: 'other.pdf',
      ),
      isFalse,
    );
    expect(
      queue.updateClientDocument(
        jobId: job.id,
        clientId: 'client-1',
        fileName: 'renamed.pdf',
      ),
      isTrue,
    );
    expect(queue.allJobs.single.fileName, 'renamed.pdf');
    expect(
      queue.deleteClientDocument(jobId: job.id, clientId: 'client-2'),
      isFalse,
    );
    expect(
      queue.deleteClientDocument(jobId: job.id, clientId: 'client-1'),
      isTrue,
    );
    expect(queue.allJobs, isEmpty);
  });

  test('accountant completion locks client edit and delete', () async {
    final queue = WorkbenchQueueService();
    final job = await queue.addJob(
      fileName: 'invoice.pdf',
      autoProcess: false,
      clientId: 'client-1',
      assignedAccountantId: 'accountant-1',
    );

    queue.completeJob(job.id);

    expect(queue.allJobs.single.isPosted, isTrue);
    expect(
      queue.updateClientDocument(
        jobId: job.id,
        clientId: 'client-1',
        fileName: 'renamed.pdf',
      ),
      isFalse,
    );
    expect(
      queue.deleteClientDocument(jobId: job.id, clientId: 'client-1'),
      isFalse,
    );
  });

  test('document hub routes client intake to assigned accountant', () async {
    final queue = WorkbenchQueueService();
    final hub = DocumentHubService(
      queueService: queue,
      accessService: ClientPortalAccessService(),
      salesService: SalesService(),
      purchaseService: PurchaseService(),
      assignedAccountantIdFor: (clientId) =>
          clientId == 'client-1' ? 'accountant-1' : '',
    );

    await hub.ingestDocument(
      clientId: 'client-1',
      channel: ClientDocumentIntakeChannel.mobileApp,
      fileName: 'invoice.pdf',
    );

    expect(queue.allJobs.single.clientId, 'client-1');
    expect(queue.allJobs.single.assignedAccountantId, 'accountant-1');
    await expectLater(
      hub.ingestDocument(
        clientId: 'client-2',
        channel: ClientDocumentIntakeChannel.mobileApp,
        fileName: 'unassigned.pdf',
      ),
      throwsA(isA<FormatException>()),
    );
  });

  test('remote OCR sync maps draft and keeps completed document locked', () {
    final queue = WorkbenchQueueService();
    final remote = RemoteOcrDocument.fromJson(<String, dynamic>{
      'id': 'document-1',
      'clientId': 'client-1',
      'assignedAccountantId': 'accountant-1',
      'originalFileName': 'purchase.pdf',
      'status': 'Completed',
      'uploadedAt': '2026-08-29T10:00:00Z',
      'updatedAt': '2026-08-29T10:05:00Z',
      'exactDuplicate': false,
      'draftJson':
          '{"voucherType":"Purchase","date":"2026-08-29",'
          '"partyName":"ABC Traders","documentNumber":"INV-1",'
          '"taxableAmount":1000,"cgst":90,"sgst":90,"igst":0,'
          '"totalAmount":1180,"confidence":0.96,'
          '"classificationExplanation":"Detected purchase invoice"}',
    });

    expect(remote.result?.detectedKind, OcrDocumentKind.purchaseBill);
    expect(remote.result?.parsedData.totalAmount, 1180);

    queue.synchronizeRemoteDocuments(<RemoteOcrDocument>[remote]);
    queue.synchronizeRemoteDocuments(<RemoteOcrDocument>[remote]);

    expect(queue.allJobs, hasLength(1));
    expect(queue.allJobs.single.isPosted, isTrue);
    expect(
      queue.deleteClientDocument(
        jobId: queue.allJobs.single.id,
        clientId: 'client-1',
      ),
      isFalse,
    );
  });

  test('portal access writes use the latest server revision and replace cache',
      () async {
    final requests = <RequestOptions>[];
    final dio = _respondingDio((options) {
      requests.add(options);
      if (options.method == 'GET') {
        return _response(options, _aggregate(loginEnabled: true, version: 7));
      }
      if (options.method == 'PATCH' && options.path == '/clients/42/access') {
        return _response(
          options,
          _aggregate(loginEnabled: false, version: 8),
        );
      }
      throw StateError('Unexpected ${options.method} ${options.path}');
    });
    final preferences = await SharedPreferences.getInstance();
    final access = ClientPortalAccessService(
      preferences: preferences,
      clientDataApi: AuthoritativeClientDataApi(dio: dio),
      useRemoteApi: true,
    );
    await access.load();

    await access.updateLoginAccess('42', loginEnabled: false);

    final patch = requests.singleWhere(
      (request) => request.method == 'PATCH',
    );
    expect((patch.data as Map<String, dynamic>)['ifMatchVersion'], 7);
    expect(access.profileFor('42').loginEnabled, isFalse);
  });

  test('a failed remote portal write leaves the cached policy unchanged',
      () async {
    final dio = Dio();
    dio.interceptors.add(
      InterceptorsWrapper(
        onRequest: (options, handler) {
          if (options.method == 'GET') {
            handler.resolve(
              _response(options, _aggregate(loginEnabled: true, version: 3)),
            );
            return;
          }
          handler.reject(
            DioException(
              requestOptions: options,
              response: _response(options, <String, dynamic>{}, statusCode: 503),
              type: DioExceptionType.badResponse,
            ),
          );
        },
      ),
    );
    final preferences = await SharedPreferences.getInstance();
    final access = ClientPortalAccessService(
      preferences: preferences,
      clientDataApi: AuthoritativeClientDataApi(dio: dio),
      useRemoteApi: true,
    );
    await access.load();

    await expectLater(
      access.updateLoginAccess('42', loginEnabled: false),
      throwsA(isA<Object>()),
    );

    expect(access.profileFor('42').loginEnabled, isTrue);
  });

  test('credential provisioning keeps its temporary password out of cache data',
      () async {
    final dio = _respondingDio((options) {
      expect(options.method, 'POST');
      expect(options.path, '/clients/42/credentials');
      expect(options.data, <String, dynamic>{'action': 'onboard'});
      return _response(
        options,
        <String, dynamic>{
          ..._aggregate(loginEnabled: true, version: 4),
          'temporaryPassword': 'Te5t@Pass',
        },
        statusCode: 201,
      );
    });

    final result = await AuthoritativeClientDataApi(
      dio: dio,
    ).provisionCredentials('42', onboarding: true);

    expect(result.temporaryPassword, 'Te5t@Pass');
    expect(result.aggregate.containsKey('temporaryPassword'), isFalse);
  });

  test('malformed remote client data preserves the prior cached directory',
      () async {
    var requestCount = 0;
    final dio = _respondingDio((options) {
      if (options.path == '/admin/staff') {
        return _response(options, <String, dynamic>{'staff': <dynamic>[]});
      }
      if (options.path != '/clients') {
        throw StateError('Unexpected ${options.method} ${options.path}');
      }
      requestCount++;
      return _response(
        options,
        <String, dynamic>{
          'clients': <Map<String, dynamic>>[
            requestCount == 1
                ? _directoryAggregate(name: 'Server Client')
                : <String, dynamic>{
                    'client': <String, dynamic>{'id': '42'},
                  },
          ],
        },
      );
    });
    final preferences = await SharedPreferences.getInstance();
    final directory = AdminUserService(
      preferences: preferences,
      dio: dio,
      clientDataApi: AuthoritativeClientDataApi(dio: dio),
      useRemoteApi: true,
    );

    await directory.load();
    await directory.load();

    expect(directory.users.where((user) => user.id == '42').single.name,
        'Server Client');
  });
}

Dio _respondingDio(
  Response<Map<String, dynamic>> Function(RequestOptions options) responseFor,
) {
  final dio = Dio();
  dio.interceptors.add(
    InterceptorsWrapper(
      onRequest: (options, handler) {
        try {
          handler.resolve(responseFor(options));
        } catch (error, stackTrace) {
          handler.reject(
            DioException(
              requestOptions: options,
              error: error,
              stackTrace: stackTrace,
            ),
          );
        }
      },
    ),
  );
  return dio;
}

Response<Map<String, dynamic>> _response(
  RequestOptions options,
  Map<String, dynamic> data, {
  int statusCode = 200,
}) {
  return Response<Map<String, dynamic>>(
    requestOptions: options,
    data: <String, dynamic>{'data': data},
    statusCode: statusCode,
  );
}

Map<String, dynamic> _aggregate({
  required bool loginEnabled,
  required int version,
}) {
  return <String, dynamic>{
    'client': <String, dynamic>{'id': '42'},
    'access': <String, dynamic>{
      'loginEnabled': loginEnabled,
      'mobileLoginEnabled': true,
      'webLoginEnabled': true,
      'twoFactorRequired': false,
      'accountLocked': false,
      'subscriptionPlan': 'standard',
      'billingMode': 'fullBillingSoftware',
      'accountingMode': 'accountsOnly',
      'purchaseEntryMode': 'both',
      'salesEntryMode': 'both',
      'modules': <String, dynamic>{},
      'dashboardWidgets': <String, bool>{},
      'documentHubAccess': <String, dynamic>{},
      'version': version,
    },
  };
}

