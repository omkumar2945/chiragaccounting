    'client': <String, dynamic>{
      'id': '42',
      'name': name,
      'email': 'client@example.com',
      'mobile': '9876543210',
      'firmName': 'Client Firm',
      'role': 'client',
      'accountOrigin': 'imported',
      'clientStatus': 'active',
      'loginStatus': 'active',
      'isActive': true,
      'mustChangePassword': false,
      'createdAt': '2026-01-01T00:00:00.000Z',
      'lastLoginAt': null,
    },
    'profile': <String, dynamic>{},
    'compliance': <String, dynamic>{},
    'assignment': <String, dynamic>{},
    'access': <String, dynamic>{},
    'workspace': <String, dynamic>{},
  };
}
